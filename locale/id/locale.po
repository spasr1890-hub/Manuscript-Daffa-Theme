msgid "plugins.themes.manuscriptDaffa.option.features.label"
msgstr "Fitur tema"

msgid "plugins.themes.manuscriptDaffa.option.features.description"
msgstr "Matikan fitur yang tidak diinginkan. Fitur yang dimatikan tidak mengubah halaman dan tidak menjalankan kueri database. Fitur yang ditambahkan di versi berikutnya otomatis menyala."

