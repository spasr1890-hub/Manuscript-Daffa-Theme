msgid "plugins.themes.manuscriptDaffa.name"
msgstr "Manuscript-Daffa"

msgid "plugins.themes.manuscriptDaffa.description"
msgstr "Child theme Manuscript yang ringan dari Default Theme dengan cakupan terbitan, negara penulis, tombol aksi artikel, badge kutipan, dan alat bantu sisi admin."

msgid "plugins.themes.manuscriptDaffa.option.typography.montserrat_notoSerif"
msgstr "Montserrat/Noto Serif"

msgid "plugins.themes.manuscriptDaffa.option.accentColour.label"
msgstr "Warna Aksen"

msgid "plugins.themes.manuscriptDaffa.option.homeCountry.label"
msgstr "Negara asal jurnal"

msgid "plugins.themes.manuscriptDaffa.option.homeCountry.description"
msgstr "Dipakai untuk menampilkan persentase penulis asing di kotak Cakupan Terbitan dan kartu Arsip. Biarkan kosong untuk menyembunyikannya."

msgid "plugins.themes.manuscriptDaffa.option.homeCountry.textDescription"
msgstr "Kode negara dua huruf jurnal, mis. ID untuk Indonesia. Biarkan kosong untuk menyembunyikan persentase penulis asing."

msgid "plugins.themes.manuscriptDaffa.option.homeCountry.none"
msgstr "(belum dipilih)"

msgid "plugins.themes.manuscriptDaffa.list.showAbstract"
msgstr "Tampilkan Abstrak"

msgid "plugins.themes.manuscriptDaffa.list.hideAbstract"
msgstr "Sembunyikan Abstrak"

msgid "plugins.themes.manuscriptDaffa.list.downloadPdf"
msgstr "Unduh PDF"

msgid "plugins.themes.manuscriptDaffa.list.scholar"
msgstr "Cek di Google Scholar"

msgid "plugins.themes.manuscriptDaffa.home.readMore"
msgstr "Selengkapnya"

msgid "plugins.themes.manuscriptDaffa.home.showLess"
msgstr "Tampilkan lebih sedikit"

